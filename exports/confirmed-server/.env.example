# ═══════════════════════════════════════════════════
#  CONFIRMED – متغيرات البيئة المطلوبة
#  انسخي هذا الملف: cp .env.example .env
#  ثم عدّلي القيم أدناه
# ═══════════════════════════════════════════════════

# ── السيرفر ───────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── قاعدة البيانات (مطلوب) ───────────────────────
# مثال محلي:   postgresql://postgres:PASSWORD@localhost:5432/confirmed_db
# مثال بعيد:   postgresql://USER:PASS@HOST:5432/DB_NAME?sslmode=require
DATABASE_URL=postgresql://postgres:كلمة_المرور@localhost:5432/confirmed_db

# ── الأمان (مطلوب) ───────────────────────────────
# اكتبي أي نص عشوائي طويل — مثال: openssl rand -hex 32
SESSION_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_STRING_AT_LEAST_32_CHARS

# ── رابط الموقع (مطلوب للإيميلات) ───────────────
# مثال: https://confirmed.yourdomain.com أو http://SERVER_IP:3000
APP_URL=http://localhost:3000

# ── الإيميلات (اختياري) ──────────────────────────
# مفتاح Brevo لإرسال OTP والإشعارات
BREVO_API_KEY=

# إيميل المُرسِل (يجب أن يكون معتمداً في Brevo)
FROM_EMAIL=noreply@yourdomain.com

# إيميل الأدمن
ADMIN_EMAIL=admin@yourdomain.com

# ── Stripe للمدفوعات (اختياري) ───────────────────
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ── للوظائف الآلية الداخلية (اختياري) ───────────
# INTERNAL_CRON_SECRET=any_random_string_here
